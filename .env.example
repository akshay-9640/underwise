# Copy to .env and run with `uv run --env-file .env underwise serve` (or export these). Never commit real keys.
# With no provider set, the app still runs: CSV counting, attachment inventory,
# and rules on any values a reviewer enters. Extraction is marked as skipped.

# Option 1: any OpenAI-compatible endpoint
# UNDERWISE_LLM_PROVIDER=openai
# Local Ollama (free):            UNDERWISE_LLM_BASE_URL=http://localhost:11434/v1   UNDERWISE_LLM_MODEL=llama3.2
# OpenAI:                         UNDERWISE_LLM_BASE_URL=https://api.openai.com/v1   UNDERWISE_LLM_MODEL=gpt-4.1-mini
# Anthropic (OpenAI-compatible):  UNDERWISE_LLM_BASE_URL=https://api.anthropic.com/v1/  UNDERWISE_LLM_MODEL=claude-sonnet-5-5
# UNDERWISE_LLM_BASE_URL=
# UNDERWISE_LLM_MODEL=
# UNDERWISE_LLM_API_KEY=

# Option 2: the Claude Code CLI (uses a Claude subscription, no API key)
# UNDERWISE_LLM_PROVIDER=claude-code
# UNDERWISE_LLM_MODEL=claude-opus-5-5
# UNDERWISE_CLAUDE_BIN=/path/to/claude     # only if `claude` is not on PATH

# Optional
# UNDERWISE_LLM_TIMEOUT=180               # seconds per model call
# UNDERWISE_DATA_DIR=runs                 # where packets and results are stored
